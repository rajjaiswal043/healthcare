{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "exclude": [".*\\.test\\.ts$", ".*/__tests__/.*"],
  "module": {
    "type": "commonjs"
  },
  "jsc": {
    "target": "es2023",
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "keepClassNames": true,
    "baseUrl": "./"
  }
}
