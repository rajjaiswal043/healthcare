{
  "name": "@healthcloud/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:check": "node scripts/migrate-check.mjs",
    "rls:check": "node scripts/rls-check.mjs",
    "rls:generate": "node scripts/rls-check.mjs --emit-sql",
    "db:reset": "prisma migrate reset --force",
    "seed:demo": "node scripts/seed-demo.mjs && node scripts/seed-auth.mjs && node scripts/seed-billing.mjs && node scripts/seed-scheduling.mjs && node scripts/seed-formulary.mjs",
    "seed:auth": "node scripts/seed-auth.mjs",
    "platform:user": "node scripts/create-platform-user.mjs",
    "seed:scheduling": "node scripts/seed-scheduling.mjs",
    "seed:formulary": "node scripts/seed-formulary.mjs",
    "seed:billing": "node scripts/seed-billing.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "build": "prisma generate && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
