# Normalise line endings to LF everywhere, including in the Windows working tree.
#
# Without this, Git checks files out as CRLF on Windows while Prettier is
# configured with `endOfLine: lf` — so `pnpm verify` fails on a fresh clone with
# every file reported as badly formatted, and every diff shows whole files
# changed. Forcing LF keeps the repo consistent whichever machine touches it.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated: collapse in diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff

# The Prisma client is committed (see .gitignore for why) but is machine-written.
# Marking it generated keeps it out of diffs and out of the language breakdown,
# so it does not look like the project is mostly generated TypeScript.
packages/db/src/generated/** linguist-generated=true -diff
