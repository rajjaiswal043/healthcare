{
  "name": "healthcloud",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "preflight": "node infra/local/preflight.mjs",
    "dev": "pnpm preflight && turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . && turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "migrate:check": "turbo run migrate:check",
    "rls:check": "turbo run rls:check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm migrate:check && pnpm rls:check && pnpm test && pnpm audit --audit-level=high",
    "prepare": "node infra/local/prepare-husky.mjs && node infra/local/generate-client.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
