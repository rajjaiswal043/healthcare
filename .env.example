# =============================================================================
# HealthCloud — local environment template
#
#   cp .env.example .env
#
# .env is gitignored and must stay that way. Nothing in here is a real secret;
# every value is a local-development default.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (ADR-003: PostgreSQL 18)
#
# Two URLs, deliberately — see ADR-005 and infra/local/bootstrap.sql.
#   DATABASE_URL        the app connects as healthcloud_app. RLS APPLIES.
#   MIGRATION_DATABASE_URL  Prisma migrations run as healthcloud_owner.
#
# The port is pinned explicitly and never defaulted: PostgreSQL 13 also runs on
# this machine (5433), so "connected to the wrong server" is a real failure mode.
# Preflight asserts the server really is major version 18.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://healthcloud_app:healthcloud_app_dev@localhost:5432/healthcloud_dev?schema=public
MIGRATION_DATABASE_URL=postgresql://healthcloud_owner:healthcloud_owner_dev@localhost:5432/healthcloud_dev?schema=public

# Integration tests truncate and re-seed this database on every run.
# It must never point at healthcloud_dev.
TEST_DATABASE_URL=postgresql://healthcloud_app:healthcloud_app_dev@localhost:5432/healthcloud_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://healthcloud_owner:healthcloud_owner_dev@localhost:5432/healthcloud_test?schema=public

# Throwaway database for Prisma's migration-drift check. Prisma DROPS AND
# RECREATES this schema on every run, so it must never point at dev or test.
SHADOW_DATABASE_URL=postgresql://healthcloud_owner:healthcloud_owner_dev@localhost:5432/healthcloud_shadow?schema=public

# -----------------------------------------------------------------------------
# Redis / Memurai (ADR-006)
# Start it once from an ELEVATED PowerShell:  Start-Service Memurai
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Auth (ADR-010)
# REQUIRED, minimum 32 characters — the app refuses to start otherwise.
# Generate your own, including for local development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-base64url-encoded-value
JWT_REFRESH_SECRET=replace-me-with-a-different-48-random-bytes-value
SESSION_COOKIE_DOMAIN=localhost

# Two-factor authentication, for clinic AND platform sign-in.
#
# OFF while HealthCloud is being demonstrated rather than used: every account
# signs in with a password alone. The API says so in its startup log.
#
# Enrolment and verification are fully implemented and the test suite turns
# this on, so switching it back is this one variable and nothing else.
#
# SET THIS TO true BEFORE REAL CLINICS HOLD REAL PATIENT DATA.
MFA_ENABLED=



# -----------------------------------------------------------------------------
# Drivers (ADR-014, ADR-017) — local implementations, swapped by config in prod
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.data/uploads
MALWARE_SCAN_DRIVER=noop
NOTIFICATION_DRIVER=console
MAIL_HOST=localhost
MAIL_PORT=1025

# -----------------------------------------------------------------------------
# Observability (ADR-015). Blank disables Sentry locally.
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# ABDM (parked until Phase 4 — see docs/runbooks/abdm-nha-application.md)
# Leave blank. Fill in from your password manager once NHA issues credentials;
# never commit real values.
# -----------------------------------------------------------------------------
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=
